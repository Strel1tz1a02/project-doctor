{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Source",
      "type": "string"
    },
    "measurement": {
      "enum": [
        "actual",
        "estimated"
      ],
      "title": "Measurement",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "source",
    "measurement"
  ],
  "title": "MetricSource",
  "type": "object"
}
