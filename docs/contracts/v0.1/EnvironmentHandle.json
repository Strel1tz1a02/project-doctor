      "type": "string"
    },
    "isolated_base_url": {
      "title": "Isolated Base Url",
      "type": "string"
    },
    "fingerprint": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Fingerprint",
      "type": "string"
    },
    "baseline_snapshot_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Baseline Snapshot Id",
      "type": "string"
    },
    "health": {
      "enum": [
        "available",
        "restoring",
        "quarantined"
      ],
      "title": "Health",
      "type": "string"
