        "payload": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "environment": "#/$defs/EnvironmentHandle",
                  "experiment": "#/$defs/ExperimentResult",
                  "report": "#/$defs/ReportResult",
                  "restore": "#/$defs/RestoreResult"
                },
                "propertyName": "result_type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/EnvironmentHandle"
                },
                {
                  "$ref": "#/$defs/ExperimentResult"
                },
                {
                  "$ref": "#/$defs/RestoreResult"
                },
                {
                  "$ref": "#/$defs/ReportResult"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload"
