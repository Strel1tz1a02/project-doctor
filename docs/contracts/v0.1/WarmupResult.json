{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Artifact Id",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Media Type",
          "type": "string"
        },
        "format_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Format Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "relative_path",
        "media_type",
        "format_version",
        "sha256",
        "size_bytes"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "code": {
          "enum": [
            "environment_blocked",
            "scenario_invalid",
            "evidence_insufficient",
            "tool_failure",
            "environment_contaminated",
            "budget_exhausted",
            "operation_conflict"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "retry_policy": {
          "enum": [
            "never",
            "reconcile_first",
            "safe_same_input"
          ],
          "title": "Retry Policy",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "retry_policy"
      ],
      "title": "Failure",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "level": {
      "enum": [
        "baseline",
        "candidate_index"
      ],
      "title": "Level",
      "type": "string"
    },
    "ordinal": {
      "exclusiveMinimum": 0,
      "title": "Ordinal",
      "type": "integer"
    },
    "request_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Request Id",
      "type": "string"
    },
    "business_valid": {
      "title": "Business Valid",
      "type": "boolean"
    },
    "result_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Digest"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "level",
    "ordinal",
    "request_id",
    "business_valid"
  ],
  "title": "WarmupResult",
  "type": "object"
}
