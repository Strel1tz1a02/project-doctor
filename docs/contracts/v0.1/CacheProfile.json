{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "cold",
        "warm",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    },
    "preparation_recipe_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preparation Recipe Ref"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "state"
  ],
  "title": "CacheProfile",
  "type": "object"
}
