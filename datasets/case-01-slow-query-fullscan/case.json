{
  "case_id": "case-01-slow-query-fullscan",
  "schema_version": "0.1",
  "title": "订单状态查询缺失 (status, created_at) 索引导致全表扫描 + filesort",
  "case_type": "normal",
  "difficulty": "easy",
  "problem_kind": "slow_query",
  "stack": {
    "language": "java",
    "framework": "spring-boot 3.2.5 + mybatis 3.0.3",
    "database": "mysql 8.0"
  },
  "symptom": {
    "summary": "GET /api/orders/recent 在 20 万订单数据集下 P95 超过 300ms；orders 表仅有 idx_orders_user_id，status 过滤与 created_at 排序无可用索引，执行计划为全表扫描 + Using filesort",
    "endpoint": "GET /api/orders/recent?status=PAID&size=20",
    "target_metric": "duration_ms"
  },
  "runtime": {
    "compose_file": "docker-compose.yml",
    "start_command": "docker compose up -d mysql && mvn spring-boot:run",
    "healthcheck": "GET /api/orders/recent?status=PAID&size=20 == 200",
    "load_profile": {
      "concurrency": 4,
      "duration_seconds": 60,
      "warmup_seconds": 10
    }
  },
  "dataset_profile": {
    "row_counts": {
      "orders": 200000
    },
    "init": "classpath:schema.sql + DataInitRunner（应用启动时生成，Random(42) 固定，status 均匀分布于 5 种取值）",
    "cache_profile": "cold_after_restart"
  },
  "defects": [
    {
      "defect_id": "d1",
      "role": "primary",
      "kind": "missing_composite_index",
      "mechanism": "orders 表只有 idx_orders_user_id(user_id)；查询按 status 过滤并 ORDER BY created_at DESC，缺少 (status, created_at) 复合索引，执行计划为全表扫描 + Using filesort",
      "code_locations": [
        {
          "path": "src/main/java/com/example/slowquery/mapper/OrderMapper.java",
          "line": 17,
          "symbol": "findOrdersByStatus"
        }
      ],
      "expected_fix": "为 orders(status, created_at) 建立复合索引，使过滤与排序均可走索引，消除全表扫描与 filesort",
      "expected_status": "verified"
    }
  ],
  "expected": {
    "decision": "verified",
    "root_cause_ids": ["d1"],
    "code_locations": [
      {
        "path": "src/main/java/com/example/slowquery/mapper/OrderMapper.java",
